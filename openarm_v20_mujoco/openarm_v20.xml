  <!-- =================================================================== -->
  <!-- SENSOR DEFINITIONS                                                  -->
  <!-- =================================================================== -->
  <sensor>
    <!-- ================================================================= -->
    <!-- Sensor 2: Motor Encoders  (Position & Velocity)                   -->
    <!-- Embedded inside each Damiao QDD actuator.                         -->
    <!-- Fed back at 9 kHz over the CAN-FD control bus.                    -->
    <!-- ================================================================= -->

    <!-- Left Arm — Joint Position Encoders -->
    <jointpos name="left_encoder_pos_shoulder_pan"  joint="openarm_left_joint1"/>  <!-- Shoulder Pan -->
    <jointpos name="left_encoder_pos_shoulder_lift" joint="openarm_left_joint2"/>  <!-- Shoulder Lift -->
    <jointpos name="left_encoder_pos_shoulder_rot"  joint="openarm_left_joint3"/>  <!-- Shoulder Rotation -->
    <jointpos name="left_encoder_pos_elbow_flex"    joint="openarm_left_joint4"/>  <!-- Elbow Flex -->
    <jointpos name="left_encoder_pos_wrist_roll"    joint="openarm_left_joint5"/>  <!-- Wrist Roll -->
    <jointpos name="left_encoder_pos_wrist_pitch"   joint="openarm_left_joint6"/>  <!-- Wrist Pitch -->
    <jointpos name="left_encoder_pos_wrist_rot"     joint="openarm_left_joint7"/>  <!-- Wrist Rotation -->
    <jointpos name="left_encoder_pos_gripper"       joint="openarm_left_finger_joint1"/>  <!-- Gripper -->

    <!-- Left Arm — Joint Velocity Encoders -->
    <jointvel name="left_encoder_vel_shoulder_pan"  joint="openarm_left_joint1"/>
    <jointvel name="left_encoder_vel_shoulder_lift" joint="openarm_left_joint2"/>
    <jointvel name="left_encoder_vel_shoulder_rot"  joint="openarm_left_joint3"/>
    <jointvel name="left_encoder_vel_elbow_flex"    joint="openarm_left_joint4"/>
    <jointvel name="left_encoder_vel_wrist_roll"    joint="openarm_left_joint5"/>
    <jointvel name="left_encoder_vel_wrist_pitch"   joint="openarm_left_joint6"/>
    <jointvel name="left_encoder_vel_wrist_rot"     joint="openarm_left_joint7"/>
    <jointvel name="left_encoder_vel_gripper"       joint="openarm_left_finger_joint1"/>

    <!-- Right Arm — Joint Position Encoders -->
    <jointpos name="right_encoder_pos_shoulder_pan"  joint="openarm_right_joint1"/>
    <jointpos name="right_encoder_pos_shoulder_lift" joint="openarm_right_joint2"/>
    <jointpos name="right_encoder_pos_shoulder_rot"  joint="openarm_right_joint3"/>
    <jointpos name="right_encoder_pos_elbow_flex"    joint="openarm_right_joint4"/>
    <jointpos name="right_encoder_pos_wrist_roll"    joint="openarm_right_joint5"/>
    <jointpos name="right_encoder_pos_wrist_pitch"   joint="openarm_right_joint6"/>
    <jointpos name="right_encoder_pos_wrist_rot"     joint="openarm_right_joint7"/>
    <jointpos name="right_encoder_pos_gripper"       joint="openarm_right_finger_joint1"/>

    <!-- Right Arm — Joint Velocity Encoders -->
    <jointvel name="right_encoder_vel_shoulder_pan"  joint="openarm_right_joint1"/>
    <jointvel name="right_encoder_vel_shoulder_lift" joint="openarm_right_joint2"/>
    <jointvel name="right_encoder_vel_shoulder_rot"  joint="openarm_right_joint3"/>
    <jointvel name="right_encoder_vel_elbow_flex"    joint="openarm_right_joint4"/>
    <jointvel name="right_encoder_vel_wrist_roll"    joint="openarm_right_joint5"/>
    <jointvel name="right_encoder_vel_wrist_pitch"   joint="openarm_right_joint6"/>
    <jointvel name="right_encoder_vel_wrist_rot"     joint="openarm_right_joint7"/>
    <jointvel name="right_encoder_vel_gripper"       joint="openarm_right_finger_joint1"/>

    <!-- ================================================================= -->
    <!-- Sensor 3: Current / Torque Feedback  (Bilateral Force Sensing)    -->
    <!-- Built into the QDD actuators. Measures motor current to estimate  -->
    <!-- external forces for bilateral teleoperation & gravity comp.       -->
    <!-- ================================================================= -->

    <!-- Left Arm — Actuator Torque / Current Feedback -->
    <actuatorfrc name="left_torque_shoulder_pan"  actuator="openarm_left_joint1"/>
    <actuatorfrc name="left_torque_shoulder_lift" actuator="openarm_left_joint2"/>
    <actuatorfrc name="left_torque_shoulder_rot"  actuator="openarm_left_joint3"/>
    <actuatorfrc name="left_torque_elbow_flex"    actuator="openarm_left_joint4"/>
    <actuatorfrc name="left_torque_wrist_roll"    actuator="openarm_left_joint5"/>
    <actuatorfrc name="left_torque_wrist_pitch"   actuator="openarm_left_joint6"/>
    <actuatorfrc name="left_torque_wrist_rot"     actuator="openarm_left_joint7"/>
    <actuatorfrc name="left_torque_gripper"       actuator="openarm_left_finger_joint1"/>

    <!-- Right Arm — Actuator Torque / Current Feedback -->
    <actuatorfrc name="right_torque_shoulder_pan"  actuator="openarm_right_joint1"/>
    <actuatorfrc name="right_torque_shoulder_lift" actuator="openarm_right_joint2"/>
    <actuatorfrc name="right_torque_shoulder_rot"  actuator="openarm_right_joint3"/>
    <actuatorfrc name="right_torque_elbow_flex"    actuator="openarm_right_joint4"/>
    <actuatorfrc name="right_torque_wrist_roll"    actuator="openarm_right_joint5"/>
    <actuatorfrc name="right_torque_wrist_pitch"   actuator="openarm_right_joint6"/>
    <actuatorfrc name="right_torque_wrist_rot"     actuator="openarm_right_joint7"/>
    <actuatorfrc name="right_torque_gripper"       actuator="openarm_right_finger_joint1"/>

    <!-- ================================================================= -->
    <!-- Sensor 4: Area Sensors / Light Curtains  (Safety)                 -->
    <!-- Rangefinder beams cast from the cell boundary inward.             -->
    <!-- Detects workspace intrusion → triggers reach-in stop.             -->
    <!-- ================================================================= -->
    <rangefinder name="safety_rangefinder_front" site="safety_curtain_front"/>
    <rangefinder name="safety_rangefinder_back"  site="safety_curtain_back"/>
    <rangefinder name="safety_rangefinder_left"  site="safety_curtain_left"/>
    <rangefinder name="safety_rangefinder_right" site="safety_curtain_right"/>
  </sensor>
