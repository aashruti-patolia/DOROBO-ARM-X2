# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Python source files
*.py text eol=lf
*.xml text eol=lf
*.urdf text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Binary assets (prevent Git from modifying line endings)
*.stl binary
*.png binary
*.jpg binary
*.pt binary
*.pth binary
